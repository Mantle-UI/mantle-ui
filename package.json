{
    "name": "@mantle-ui/react",
    "private": false,
    "version": "10.10.7",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mantle-UI/mantle-ui.git"
    },
    "bin": {
        "mantleui": "./bin/mantle-ui-migrate.cjs"
    },
    "scripts": {
        "dev": "npm run dev:docs",
        "start": "npm run start:docs",
        "build": "npm run build:docs",
        "dev:docs": "next dev",
        "start:docs": "next start",
        "build:docs": "next build",
        "build:docs:pages": "next build",
        "build:bundle": "rollup -c",
        "build:assets": "gulp build-resources",
        "build:dist": "npm run build:check && npm run build:bundle && npm run build:assets && npm run build:api",
        "build:dist:watch": "npm run build:check && npm run build:assets && npm run build:api && npm run build:bundle -- --watch",
        "build:lib": "NODE_ENV=production INPUT_DIR=components/lib/ OUTPUT_DIR=dist/ npm run build:dist",
        "build:lib:windows": "set \"NODE_ENV=production\" && set \"INPUT_DIR=components/lib/\" && set \"OUTPUT_DIR=dist/\" && npm run build:dist",
        "build:package": "npm run build:dist",
        "dev:link": "NODE_ENV=production INPUT_DIR=components/lib/ OUTPUT_DIR=dist/ npm run build:dist:watch",
        "dev:link:windows": "set \"NODE_ENV=production\" && set \"INPUT_DIR=components/lib/\" && set \"OUTPUT_DIR=dist/\" && npm run build:dist:watch",
        "build:package:dev": "npm run build:dist:watch",
        "build:api": "npm run apiwebtypes && npm run apidoc",
        "build:check": "npm run lint && npm run format:check && npm run type:check",
        "build:verify": "npm run build:check && npm run security:check",
        "security:check": "npm audit --omit=dev --audit-level critical",
        "format": "prettier --write \"{components,pages,service,api-scripts}/**/*.{js,ts,tsx,d.ts}\"",
        "format:check": "prettier --check \"{components,pages,service,api-scripts}/**/*.{js,ts,tsx,d.ts}\"",
        "lint": "eslint --max-warnings=0 components pages service api-scripts",
        "lint:fix": "eslint --fix components pages service api-scripts",
        "type:check": "tsc -p ./api-scripts/tsconfig.json",
        "test": "jest --watch --coverage --silent",
        "test:check": "jest --watchAll=false --coverage --silent",
        "test:debug": "jest --watch --coverage",
        "apidoc": "node ./api-scripts/build-apidoc.js",
        "apiwebtypes": "node ./api-scripts/build-webtypes.js"
    },
    "dependencies": {
        "@docsearch/react": "^4.7.0",
        "@mantle-ui/flex": "^3.4.1",
        "@mantle-ui/icons": "^7.1.1",
        "chart.js": "4.5.1",
        "file-saver": "2.0.5",
        "fs-extra": "^11.4.0",
        "jspdf": "4.2.1",
        "jspdf-autotable": "5.0.8",
        "next": "^16.2.12",
        "path": "^0.12.7",
        "quill": "^2.0.2",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-transition-group": "^4.4.5",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/plugin-transform-runtime": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@eslint/compat": "^2.1.0",
        "@rollup/plugin-alias": "^6.0.0",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@stackblitz/sdk": "1.11.1",
        "@svgr/webpack": "^8.1.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-transition-group": "^4.4.12",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.2.12",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest-dom": "^5.5.0",
        "gulp": "^5.0.1",
        "gulp-concat": "^2.6.1",
        "gulp-flatten": "^0.4.0",
        "gulp-rename": "^2.1.0",
        "gulp-uglify": "^3.0.2",
        "gulp-uglifycss": "^1.1.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "postcss": "^8.5.24",
        "prettier": "3.9.6",
        "rollup": "^4.62.3",
        "rollup-plugin-postcss": "^4.0.2",
        "sass": "^1.79.4",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=20.10.0"
    },
    "overrides": {
        "postcss": "$postcss",
        "sharp": "0.35.3"
    }
}
